    SERVICES ==> PG["PostgreSQL<br><br>
    <b>5 services = 5 schemas</b><br>
    • <b>auth_db</b> : users, oauth_tokens, sessions, refresh_tokens<br>
    • <b>player_db</b> : profiles, friendships, statistics, achievements<br>
    • <b>lobby_db</b> : rooms, room_players, room_configs, invitations<br>
    • <b>game_db</b> : games, game_players, game_events, game_phases, votes<br>
    • <b>chat_db</b> : messages, conversations, blocked_users, read_status<br>"] & REDIS["Redis (Cache + Pub/Sub)<br><br>
    <b>Namespaces:</b><br>
    • <b>Auth</b> : session, ratelimit, 2FA
    • <b>Player</b> : profile, presence, friends:online
    • <b>Lobby</b> : room:players, matchmaking, room:config
    • <b>Game</b> : state, votes, ws:connections
    • <b>Chat</b> : messages_buffer, typing, unread_count<br><br>
    <b>Pub/Sub channels:</b><br>
    • game:events, chat:messages, lobby:updates, global:presence"]
    
    LOBBY -. POST /internal/game/create<br>(room_id, players, config).-> GAME
    GAME <-. Redis Pub/Sub<br>game:events .-> CHAT
    
