---
config:
  layout: dagre
  look: neo
  theme: default
  themeVariables:
    spacing: 80
    nodeSpacing: 90
    rankSpacing: 140
    padding: 32
---
flowchart TB
  %% === CLIENTS + NGINX + GATEWAY ===
  CLIENTS["<b>CLIENTS</b><br><br>React SPA<br><br><b>Contexts:</b><br>AuthContext<br>LobbyContext<br>GameContext<br>ChatContext"]:::clientStyle
  NGINX["<b>NGINX :8443</b><br><br>• TLS (HTTPS)<br>• Serve static files<br>&nbsp;&nbsp;(React build)<br>• Reverse proxy /api<br>&nbsp;&nbsp;→ gateway:4000<br>• WSS upgrade"]:::nginxStyle
  GATEWAY["<b>API GATEWAY :4000</b><br>(Express)<br><br><b>PUBLIC ROUTES :</b><br>/api/auth/*<br>/api/players/*<br>/api/chat/*<br>/api/lobby/* (WSS)<br>/api/game/* (WSS)<br><br><b>Middleware :</b><br>• JWT authGuard<br>• Header injection<br>(x-user-id, x-user-username,<br>x-user-email)<br>• WSS upgrade auth"]:::gatewayStyle
  CLIENTS ==>|HTTPS / WSS| NGINX
  NGINX ==>|HTTPS / WSS| GATEWAY

  %% === MICROSERVICES SECTION ===
  subgraph SERVICES["Microservices (REST + WSS)"]
    direction LR
    AUTH["<b>AUTH :3000</b><br>• Register / Login / Logout<br>• JWT access + refresh<br>• Token rotation<br>• Password hashing<br>• /internal/users/:id (DELETE, PATCH)"]:::serviceStyle
    PLAYER["<b>PLAYER :3001</b><br>• CRUD profiles<br>• Avatar upload<br>• Friends system<br>• Block users<br>• Game statistics<br>• Match history<br>• /internal/users (POST)<br>• /internal/users/batch (POST)"]:::serviceStyle
    CHAT["<b>CHAT :2000 <i>(REST + WSS)</b></i><br>• Lobby / game messages<br>• Direct messages<br>• Chat history<br>• Block users<br>• Typing indicators<br>• Sound buzzers<br>• Game invitations<br>• /internal/users/:id (DELETE)<br>• /internal/block (POST)<br>• /internal/unblock (DELETE)"]:::chatStyle
    LOBBY["<b>LOBBY :3003 <i>(WSS)</i></b><br>• Create / Join / Leave<br>• Matchmaking queue<br>• Room config<br>• Ready check<br>• Start game trigger"]:::serviceStyle
    GAME["<b>GAME :3002 <i>(WSS)</i></b><br>• Card game state machine<br>• Turn management<br>• 3–6 players<br>• Disconnect / reconnect<br>• Win conditions (trios)<br>• /internal/create (POST)"]:::serviceStyle
  end

  GATEWAY ==> AUTH
  GATEWAY ==> PLAYER
  GATEWAY ==> CHAT
  GATEWAY -. WSS .-> LOBBY
  GATEWAY -. WSS .-> GAME

  %% === DATABASES ===
  PG["<b>PostgreSQL</b><br><br><b>3 schemas :</b><br>• <b>auth</b> : users, refresh_tokens<br>• <b>player</b> : users, friendships,<br>&nbsp;&nbsp;blocked, match_history<br>• <b>chat</b> : ws_messages,<br>&nbsp;&nbsp;direct_conversations,<br>&nbsp;&nbsp;direct_messages, blocked_users"]:::dbStyle
  REDIS["<b>Redis</b><br><br><b>Pub/Sub channels :</b><br>• chat:messages<br>• dm:newMessage<br>• lobby:membersChanged<br>• lobby:gameStarting<br>• user:statusChanged<br>• game:ended<br><br><b>List :</b><br>• game:results (stats-worker)<br><br><b>Sets :</b><br>• users:online<br>• chat:blocked:$userId"]:::redisStyle

  AUTH & PLAYER & CHAT -. DB .-> PG
  CHAT & PLAYER & LOBBY & GAME -. Pub/Sub .-> REDIS

  %% === INTERNAL ROUTES ===
  subgraph INTERNAL["Internal routes (triple_network only)"]
    direction TB
    I1["AUTH /internal/users/:id<br>DELETE &amp; PATCH"]
    I2["PLAYER /internal/users<br>POST"]
    I2B["PLAYER /internal/users/batch<br>POST"]
    I3["CHAT /internal/users/:id<br>DELETE"]
    I4["GAME /internal/create<br>POST"]
  end
  class INTERNAL internalGroupStyle
  class I1,I2,I2B,I3,I4 internalStyle

  PLAYER -- "sync username/email/password<br>delete cascade" --> I1
  AUTH -- "create profile<br>on signup" --> I2
  CHAT -- "resolve usernames<br>(DM, lobby chat)" --> I2B
  PLAYER -- "purge user data<br>" --> I3
  LOBBY -- "start game<br>(players, config)" --> I4

  %% === WS NOTES ===
  subgraph WS_NOTES["Socket.io (via Gateway)"]
    direction TB
    WS_CHAT_NOTE@{ shape: braces, label: "<b>/api/chat</b><br>• chat:join / message / typing<br>• chat:sound / notification<br>• user:statusChanged<br>• dm:message / typing / read" }
    WS_LOBBY_NOTE@{ shape: braces, label: "<b>/api/lobby</b><br>• lobby:create / join / ready<br>• lobby:start / back<br>• lobby:rulesChanged / readyChanged<br>• lobby:gameStarting / disconnected<br>• matchmaking:join / leave" }
    WS_GAME_NOTE@{ shape: braces, label: "<b>/api/game</b><br>• game:join / action / check<br>• game:started / update / turnChanged<br>• game:ended / reconnected<br>• game:playerDisconnected<br>• game:playerReconnected<br>• game:playerEliminated" }
  end
  class WS_NOTES wsNotesStyle
  class WS_LOBBY_NOTE,WS_GAME_NOTE,WS_CHAT_NOTE noteStyle

  GATEWAY -. "WSS upgrade" .-> WS_NOTES

  %% === CLASSES ===
  classDef clientStyle fill:#e1f5ff,stroke:#01579b,stroke-width:3px,color:#000
  classDef nginxStyle fill:#e8eaf6,stroke:#283593,stroke-width:3px,color:#000
  classDef gatewayStyle fill:#fff3e0,stroke:#e65100,stroke-width:3px,color:#000
  classDef serviceStyle fill:#f3e5f5,stroke:#4a148c,stroke-width:2.5px,color:#000
  classDef chatStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2.5px,color:#000
  classDef dbStyle fill:#ffebee,stroke:#b71c1c,stroke-width:2.5px,color:#000
  classDef redisStyle fill:#fff9c4,stroke:#f57f17,stroke-width:2.5px,color:#000
  classDef noteStyle fill:#fafafa,stroke:#9e9e9e,stroke-width:1px,color:#000,font-size:10px
  classDef wsNotesStyle fill:#f5f5f5,stroke:#bdbdbd,stroke-width:1px,stroke-dasharray:5 5
  classDef internalStyle fill:#e0f2f1,stroke:#00695c,stroke-width:2px,color:#000,font-size:10px
  classDef internalGroupStyle fill:#f1f8e9,stroke:#33691e,stroke-width:1px,stroke-dasharray:5 5

  %% === LINK STYLES ===
  linkStyle default stroke-width:2px,stroke:#444,fill:none
  linkStyle 0,1,2,3,4,5,6 stroke:#1e88e5,stroke-width:2.5px
  linkStyle 7,8,9 stroke:#43a047,stroke-width:2px,stroke-dasharray:4 2
  linkStyle 10,11,12,13 stroke:#ef6c00,stroke-width:2px,stroke-dasharray:2 2
  linkStyle 14,15,16,17,18 stroke:#6a1b9a,stroke-width:2px,stroke-dasharray:3 2
