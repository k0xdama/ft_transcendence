    },
    {
      "id": "LkSgK3p_xLe9fXAPZ6W63",
      "type": "text",
      "x": 211.44444444444457,
      "y": 1002.1111111111112,
      "width": 355.79998779296875,
      "height": 380,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 164843113,
      "version": 1453,
      "versionNonce": 1168497033,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768843577914,
      "link": null,
      "locked": false,
      "text": "\n• Isolation logique seulement\n\n• Point de défaillance unique --> PG down =\n  tout down\n\n• Risque de requêtes croisées entre schémas\n  (JOIN techniquement possible)\n\n• Migrations bloquantes : une migration lourde\n  sur un schéma peut ralentir les autres\n\n• Contention possible sous forte charge (pas\n  le cas pour les requis de transcendence)\n\n• Une requête lente impacte tous les services\n\n• Impossible de changer de techno DB par\n  service",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "BsIMG9F6Rw8Mq-WxnZn4U",
      "originalText": "\n• Isolation logique seulement\n\n• Point de défaillance unique --> PG down =\n  tout down\n\n• Risque de requêtes croisées entre schémas\n  (JOIN techniquement possible)\n\n• Migrations bloquantes : une migration lourde\n  sur un schéma peut ralentir les autres\n\n• Contention possible sous forte charge (pas\n  le cas pour les requis de transcendence)\n\n• Une requête lente impacte tous les services\n\n• Impossible de changer de techno DB par\n  service",
      "autoResize": true,
      "lineHeight": 1.25
    },
