    {
      "id": "teKlF-daaM8olWydMwqnM",
      "type": "text",
      "x": 212.11111111111111,
      "y": 422.3333333333333,
      "width": 350.1833190917969,
      "height": 500,
      "angle": 0,
      "strokeColor": "#099268",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 457843209,
      "version": 1026,
      "versionNonce": 1672429543,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768843329499,
      "link": null,
      "locked": false,
      "text": "\n• Setup rapide, 1 seul backup\n\n• Données centralisées --> Debug + simple\n\n• Communication simplifiée : moins d'appels\n   inter-services\n\n• Latence réduite\n\n• Transactions cross-services possibles\n  (ex: créer un user + son profil en une fois)\n\n• Pas de duplication de données\n\n• Moindre usage de la RAM + CPU\n\n• 8 conteneurs seulement, 2 healthchecks\n  (1 PostgreSQL, 1 Redis)\n\n• Pas besoin de synchroniser les données\n\n• Cohérence des données, monitoring simplifié\n\n• Contrats d'API + simples",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "5NEEYEk-NAigxSqgvsgTM",
      "originalText": "\n• Setup rapide, 1 seul backup\n\n• Données centralisées --> Debug + simple\n\n• Communication simplifiée : moins d'appels\n   inter-services\n\n• Latence réduite\n\n• Transactions cross-services possibles\n  (ex: créer un user + son profil en une fois)\n\n• Pas de duplication de données\n\n• Moindre usage de la RAM + CPU\n\n• 8 conteneurs seulement, 2 healthchecks\n  (1 PostgreSQL, 1 Redis)\n\n• Pas besoin de synchroniser les données\n\n• Cohérence des données, monitoring simplifié\n\n• Contrats d'API + simples",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ccmySTECfWk38haNQT8Be",
      "type": "rectangle",
      "x": 678,
      "y": 328,
      "width": 304,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
